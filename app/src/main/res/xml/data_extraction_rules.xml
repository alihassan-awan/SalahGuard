<?xml version="1.0" encoding="utf-8"?>
<!-- No automatic cloud backup or device transfer of personal prayer/location data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
